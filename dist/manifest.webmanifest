{
  "id": "/?source=pwa",
  "name": "BEU Exam Dost",
  "short_name": "BEU Exam Dost",
  "description": "Offline study planner, syllabus tracker, PYQs, and exam companion for Bihar Engineering University (BEU) students.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#f7f9fb",
  "theme_color": "#16663e",
  "orientation": "portrait-primary",
  "dir": "ltr",
  "lang": "en",
  "categories": [
    "education",
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./assets/screenshot-mobile.png",
      "sizes": "768x1376",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "BEU Exam Dost study planner and active subjects on mobile"
    },
    {
      "src": "./assets/screenshot-desktop.png",
      "sizes": "1376x768",
      "type": "image/png",
      "form_factor": "wide",
      "label": "BEU Exam Dost comprehensive dashboard on desktop"
    }
  ],
  "shortcuts": [
    {
      "name": "Past Year Questions (PYQs)",
      "short_name": "PYQs",
      "description": "Access semester exam question papers",
      "url": "./#/pyqs",
      "icons": [
        {
          "src": "./assets/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Practice Quiz",
      "short_name": "Quiz",
      "description": "Test your preparation with timed quizzes",
      "url": "./#/quiz",
      "icons": [
        {
          "src": "./assets/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Subjects & Syllabus",
      "short_name": "Subjects",
      "description": "View subject unit checklists and notes",
      "url": "./#/subjects",
      "icons": [
        {
          "src": "./assets/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "auto"
}
